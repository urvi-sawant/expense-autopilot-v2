# Expense Autopilot Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# OCR & Vision Model Provider (Optional)
# If left empty, built-in Pillow preprocessing and OCR engine handles extraction
VISION_API_PROVIDER=mock_vision
VISION_API_KEY=

# Corporate Policy Defaults
DEFAULT_CURRENCY=INR
TIER1_DAILY_MEAL_LIMIT=2000.0
TIER2_DAILY_MEAL_LIMIT=1500.0
VP_APPROVAL_THRESHOLD=5000.0
ROUNDING_TOLERANCE=1.00
